<clickhouse>
    <prometheus>
        <port>9093</port>
        <handlers>
            <compliance_write>
                <url>/write</url>
                <handler>
                    <type>remote_write</type>
                    <table>default.prometheus</table>
                </handler>
            </compliance_write>
            <compliance_read>
                <url>/read</url>
                <handler>
                    <type>remote_read</type>
                    <table>default.prometheus</table>
                </handler>
            </compliance_read>
            <compliance_query>
                <url>/api/v1/query</url>
                <handler>
                    <type>query_api</type>
                    <table>default.prometheus</table>
                </handler>
            </compliance_query>
            <compliance_query_range>
                <url>/api/v1/query_range</url>
                <handler>
                    <type>query_api</type>
                    <table>default.prometheus</table>
                </handler>
            </compliance_query_range>
            <compliance_series>
                <url>/api/v1/series</url>
                <handler>
                    <type>query_api</type>
                    <table>default.prometheus</table>
                </handler>
            </compliance_series>
            <compliance_labels>
                <url>/api/v1/labels</url>
                <handler>
                    <type>query_api</type>
                    <table>default.prometheus</table>
                </handler>
            </compliance_labels>
            <compliance_label_values>
                <url>/api/v1/label/*/values</url>
                <handler>
                    <type>query_api</type>
                    <table>default.prometheus</table>
                </handler>
            </compliance_label_values>
        </handlers>
    </prometheus>
</clickhouse>
