<clickhouse>
    <http_handlers>
        <defaults/>
        <rule>
            <url_prefix>/prometheus/api/v1</url_prefix>
            <handler>
                <type>prometheus_api_v1</type>
                <database>default</database>
                <table>prometheus</table>
            </handler>
        </rule>
    </http_handlers>
</clickhouse>
